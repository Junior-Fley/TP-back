      "costoEstadiaDiario": 2600
    },
    {
      "orden": 2,
      "tipoTramo": "entre_depositos",
      "latitudOrigen": -27.7834,
      "longitudOrigen": -64.2642,
      "nombreOrigen": "Logística Santiago del Estero",
      "idDepositoOrigen": 43,
      "latitudDestino": -32.9442,
      "longitudDestino": -60.6505,
      "nombreDestino": "Parque Logístico Rosario",
